# Copy to .env.production. This file is intentionally ignored by Git.
# SQLite is the tested single-host product database. PostgreSQL URLs are not
# accepted by this build until the PostgreSQL adapter and integration suite land.
DATABASE_URL=sqlite:////var/lib/nexus/nexus.db
NEXUS_WEB_ORIGINS=http://localhost:3000
NEXUS_ALLOW_REAL_READS=true
# Disabled by default. When true, a visitor can create a new isolated tenant,
# owner, and primary project; they can never join or inspect another tenant.
NEXUS_ALLOW_OWNER_REGISTRATION=false
NEXUS_GITHUB_REPOSITORY=Themeta-verse/Nexus
# NEXUS_GITHUB_TOKEN=product-managed-secret-for-private-repository-reads
